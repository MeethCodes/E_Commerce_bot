{
    "manifest_version": 3,
    "name": "Buggy2",
    "version": "1.0.0",
    "description": "still thinking",
    "icons": {
        "16": "./icons/lookfor_16.png",
        "32": "./icons/lookfor_32.png",
        "48": "./icons/lookfor_48.png",
        "128": "./icons/lookfor_128.png"
    },
    "permissions": ["activeTab", "scripting" , "storage", "webNavigation", "tabs"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["static/content.js"]
        }
    ],
    "action": {
        "default_popup": "templates/popup.html",
        "default_icon": {
            "16": "./icons/lookfor_16.png",
            "48": "./icons/lookfor_48.png",
            "128": "./icons/lookfor_128.png"
        }
    }
}
